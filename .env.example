# ==============================================================================
# IS-Assist Environment Configuration Example
# Set these variables in the Render Dashboard under "Environment Variables".
# ==============================================================================

# Required: Groq Cloud API Key (Get free from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default is Llama 3.3 70B or gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Sentence Transformers Embedding Model for ChromaDB
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage paths
CHROMA_PATH=./storage/chroma
STANDARDS_PATH=./data/standards.json

# Retrieval configuration
TOP_K=5
MAX_UPLOAD_MB=10

# CORS origins (for local development or cross-origin access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
